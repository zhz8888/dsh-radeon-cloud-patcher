# 依赖
node_modules/
# pnpm 的 store 会向上寻址到 git 根目录创建
.pnpm-store/

# 密钥与本地凭据
# 密钥正常存放于 ~/.dsh/.credentials.yaml，不进仓库；以下规则兜住手工落在项目内的副本
.env
.env.*
!.env.example
*.key
*.pem
*.p12
credentials.yaml
.credentials.yaml
secrets.yaml

# 配置合并前自动生成的备份文件
*.bak
*.bak-*

# 测试与覆盖率产物
coverage/
*.lcov
.nyc_output/

# 日志与临时文件
*.log
*.tmp
*.temp
.cache/

# 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes
Thumbs.db
desktop.ini
