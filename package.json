{
  "name": "@zhz8888/dsh-radeon-cloud-patcher",
  "version": "1.1.1",
  "description": "\u4e3a DeepSeek Harness \u63a5\u5165 AMD Radeon Cloud\uff0c\u5b8c\u6574\u652f\u6301\u6a21\u578b\u601d\u8003\uff08reasoning\uff09\u529f\u80fd\u3002\u628a provider \u5b9a\u4e49\u6309\u952e\u5408\u5e76\u8fdb profile\uff0c\u7531 DSH \u81ea\u5e26\u7684 dsh-llm-pi-ai \u627f\u8f7d\uff0c\u4e0d\u4fee\u6539 DSH \u672c\u4f53\uff0c\u4e5f\u4e0d\u81ea\u7814\u9002\u914d\u5668\u3002",
  "keywords": [
    "amd",
    "deepseek-harness",
    "dsh",
    "llm",
    "patcher",
    "provider",
    "radeon",
    "radeon-cloud",
    "reasoning",
    "thinking"
  ],
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "author": {
    "name": "zhz8888"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhz8888/dsh-radeon-cloud-patcher.git"
  },
  "homepage": "https://github.com/zhz8888/dsh-radeon-cloud-patcher#readme",
  "bugs": {
    "url": "https://github.com/zhz8888/dsh-radeon-cloud-patcher/issues"
  },
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./merge": "./src/merge.js",
    "./provider": "./provider/radeon-cloud.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.plugin.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "files": [
    "src",
    "provider",
    "scripts",
    "cordis.plugin.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node test/merge.test.mjs && node test/patch-text.test.mjs && node test/ownership.test.mjs && node test/apply-guard.test.mjs && node test/patch-sync.test.mjs && node test/verify-reasoning.mjs",
    "test:merge": "node test/merge.test.mjs && node test/patch-text.test.mjs && node test/ownership.test.mjs",
    "test:guard": "node test/apply-guard.test.mjs",
    "test:patch": "node test/patch-sync.test.mjs",
    "test:reasoning": "node test/verify-reasoning.mjs",
    "sync:patch": "node scripts/sync-bundle-patch.mjs",
    "validate": "node scripts/validate-config.mjs",
    "probe": "node scripts/probe-efforts.mjs",
    "install:profile": "node scripts/apply-to-profile.mjs",
    "install:profile:dry": "node scripts/apply-to-profile.mjs --dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0"
  }
}
